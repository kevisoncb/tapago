rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: Users
    // Document ID: Firebase Auth uid
    // Fields:
    //   - email: string (required)
    //   - nome: string (required)
    //   - chave_pix: string
    //   - telefone: string (optional)
    //   - whatsapp_conectado: bool
    //   - notificacoes_diarias: bool
    //   - acesso_biometrico: bool
    //   - banco, agencia, conta: string
    //   - mensagem_cobranca: string
    //   - mensagem_atraso, mensagem_atraso_forte: string (opcional; Premium)
    //   - aceite_termos_em, aceite_privacidade_em: timestamp (optional)
    //   - is_premium: bool (server-only after create)
    //   - premium_vence_em: timestamp (server-only)
    //   - premium_transaction_id: string (server-only)
    //
    // Collection: Debts
    // Document ID: debtId
    // Fields:
    //   - user_id: string (immutable, must equal auth.uid)
    //   - nome, telefone: string
    //   - valor_principal, taxa_juros: number
    //   - data_vencimento, created_at: timestamp
    //   - status_pago: bool
    //   - client_score: number
    //
    // Collection: Payments
    // Document ID: paymentId
    // Fields:
    //   - user_id: string (immutable, must equal auth.uid)
    //   - debt_id: string
    //   - valor: number
    //   - data: timestamp
    //   - descricao: string
    //
    // Collection: Bills (boletos a pagar, Premium)
    // Fields:
    //   - user_id: string (must equal auth.uid)
    //   - fornecedor: string, valor: number, codigo: string (optional)
    //   - data_vencimento, created_at, pago_em: timestamp
    //   - pago: bool, grupo_id: string, parcela/total_parcelas: int
    // Create/update require active Premium on the Users doc.
    //
    // Collection: PremiumCharges
    // Written only by Admin SDK (webhook / Functions). Clients: deny.
    //
    // Collection: Presence (doc id = uid)
    //   - last_seen_at: server timestamp, plataforma: string
    // Owner writes its own heartbeat; only the admin panel (Admin SDK) reads.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/DeletedAccounts/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function optionalString(data, field, maxLen) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLen);
    }

    function requiredString(data, field, maxLen) {
      return data[field] is string
        && data[field].size() > 0
        && data[field].size() <= maxLen;
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields([
          'email',
          'nome',
          'nome_loja',
          'limpeza_auto',
          'chave_pix',
          'telefone',
          'whatsapp_conectado',
          'notificacoes_diarias',
          'lembretes_acompanhamento',
          'acesso_biometrico',
          'banco',
          'agencia',
          'conta',
          'mensagem_cobranca',
          'mensagem_atraso',
          'mensagem_atraso_forte',
          'aceite_termos_em',
          'aceite_privacidade_em',
          'is_premium',
          'premium_vence_em',
          'premium_transaction_id',
        ])
        && requiredString(data, 'email', 120)
        && requiredString(data, 'nome', 80)
        && optionalString(data, 'nome_loja', 80)
        && optionalString(data, 'chave_pix', 120)
        && optionalString(data, 'telefone', 24)
        && optionalString(data, 'banco', 80)
        && optionalString(data, 'agencia', 20)
        && optionalString(data, 'conta', 24)
        && optionalString(data, 'mensagem_cobranca', 2000)
        && optionalString(data, 'mensagem_atraso', 2000)
        && optionalString(data, 'mensagem_atraso_forte', 2000)
        && optionalBool(data, 'limpeza_auto')
        && optionalBool(data, 'whatsapp_conectado')
        && optionalBool(data, 'notificacoes_diarias')
        && optionalBool(data, 'lembretes_acompanhamento')
        && optionalBool(data, 'acesso_biometrico')
        && optionalTimestamp(data, 'aceite_termos_em')
        && optionalTimestamp(data, 'aceite_privacidade_em')
        && optionalBool(data, 'is_premium')
        && optionalTimestamp(data, 'premium_vence_em')
        && optionalString(data, 'premium_transaction_id', 120);
    }

    function premiumUnchanged() {
      return request.resource.data.get('is_premium', false)
          == resource.data.get('is_premium', false)
        && request.resource.data.get('premium_vence_em', null)
          == resource.data.get('premium_vence_em', null)
        && request.resource.data.get('premium_transaction_id', null)
          == resource.data.get('premium_transaction_id', null);
    }

    function premiumStartsFree() {
      return dataFalse(request.resource.data, 'is_premium')
        && request.resource.data.get('premium_vence_em', null) == null
        && request.resource.data.get('premium_transaction_id', null) == null;
    }

    function dataFalse(data, field) {
      return !(field in data) || data[field] == false;
    }

    function isValidDebt(data) {
      return hasOnlyAllowedFields([
          'user_id',
          'nome',
          'telefone',
          'valor_principal',
          'taxa_juros',
          'data_vencimento',
          'status_pago',
          'client_score',
          'grupo_id',
          'parcela',
          'total_parcelas',
          'itens',
          'manter',
          'created_at',
          'grupo_id',
          'parcela',
          'total_parcelas',
          'ledger_revision',
          'ledger_payment_id',
        ])
        && data.user_id is string
        && data.user_id == request.auth.uid
        && requiredString(data, 'nome', 80)
        && optionalString(data, 'telefone', 24)
        && data.valor_principal is number
        && data.valor_principal >= 0
        && data.valor_principal <= 100000000
        && data.taxa_juros is number
        && data.taxa_juros >= 0
        && data.taxa_juros <= 1000
        && data.data_vencimento is timestamp
        && data.status_pago is bool
        && data.client_score is number
        && data.client_score >= 0
        && data.client_score <= 100
        && optionalString(data, 'grupo_id', 80)
        && data.get('parcela', 1) is int
        && data.get('total_parcelas', 1) is int
        && data.get('total_parcelas', 1) >= 1
        && data.get('total_parcelas', 1) <= 12
        && data.get('parcela', 1) >= 1
        && data.get('parcela', 1) <= data.get('total_parcelas', 1)
        && optionalBool(data, 'manter')
        && data.get('itens', []) is list
        && data.get('itens', []).size() <= 100
        && data.get('ledger_revision', 0) is int
        && data.get('ledger_revision', 0) >= 0
        && optionalString(data, 'ledger_payment_id', 80)
        && optionalTimestamp(data, 'created_at');
    }

    function isValidPayment(data) {
      return hasOnlyAllowedFields([
          'user_id',
          'debt_id',
          'valor',
          'data',
          'descricao',
          'estornado_em',
          'estorno_motivo',
        ])
        && data.user_id is string
        && data.user_id == request.auth.uid
        && data.debt_id is string
        && data.debt_id.size() > 0
        && data.debt_id.size() <= 80
        && data.valor is number
        && data.valor > 0
        && data.valor <= 100000000
        && data.data is timestamp
        && data.descricao is string
        && data.descricao.size() > 0
        && data.descricao.size() <= 80
        && optionalTimestamp(data, 'estornado_em')
        && optionalString(data, 'estorno_motivo', 200);
    }

    function paymentDebt(data) {
      return getAfter(/databases/$(database)/documents/Debts/$(data.debt_id)).data;
    }

    function paymentHasOwnedDebt(data) {
      return paymentDebt(data).user_id == request.auth.uid;
    }

    // Marked ledgers can only be changed together with the parent revision.
    // Unmarked legacy records remain usable until their first upgraded write.
    function coordinatedPayment(data, paymentId) {
      let before = get(/databases/$(database)/documents/Debts/$(data.debt_id)).data;
      let after = paymentDebt(data);
      return after.get('ledger_revision', 0) == before.get('ledger_revision', 0) + 1
        && after.get('ledger_payment_id', '') == paymentId;
    }

    function ledgerAdvance(debtId) {
      let paymentId = request.resource.data.get('ledger_payment_id', '');
      let paymentPath = /databases/$(database)/documents/Payments/$(paymentId);
      let after = getAfter(paymentPath).data;
      return request.resource.data.get('ledger_revision', 0) == resource.data.get('ledger_revision', 0) + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status_pago', 'ledger_revision', 'ledger_payment_id'
        ])
        && after.user_id == request.auth.uid
        && after.debt_id == debtId
        && (!exists(paymentPath)
          || (get(paymentPath).data.get('estornado_em', null) == null
            && after.get('estornado_em', null) == request.time));
    }

    function safeDebtUpdate(debtId) {
      let before = resource.data.get('ledger_revision', 0);
      let after = request.resource.data.get('ledger_revision', 0);
      return (before == 0 && after == 0)
        || (before > 0 && after == before
          && request.resource.data.get('ledger_payment_id', '') == resource.data.get('ledger_payment_id', '')
          && request.resource.data.valor_principal == resource.data.valor_principal
          && request.resource.data.taxa_juros == resource.data.taxa_juros
          && request.resource.data.status_pago == resource.data.status_pago)
        || ledgerAdvance(debtId);
    }

    function hasActivePremium() {
      let profile = get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
      return profile.get('is_premium', false) == true
        && profile.get('premium_vence_em', null) is timestamp
        && profile.premium_vence_em > request.time;
    }

    function isValidBill(data) {
      return hasOnlyAllowedFields([
          'user_id',
          'fornecedor',
          'valor',
          'data_vencimento',
          'codigo',
          'pago',
          'pago_em',
          'grupo_id',
          'parcela',
          'total_parcelas',
          'created_at',
        ])
        && data.user_id is string
        && data.user_id == request.auth.uid
        && requiredString(data, 'fornecedor', 80)
        && data.valor is number
        && data.valor > 0
        && data.valor <= 100000000
        && data.data_vencimento is timestamp
        && optionalString(data, 'codigo', 64)
        && data.pago is bool
        && optionalTimestamp(data, 'pago_em')
        && optionalString(data, 'grupo_id', 80)
        && data.parcela is int
        && data.total_parcelas is int
        && data.total_parcelas >= 1
        && data.total_parcelas <= 12
        && data.parcela >= 1
        && data.parcela <= data.total_parcelas
        && optionalTimestamp(data, 'created_at');
    }

    match /Users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && premiumStartsFree();
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && premiumUnchanged();
      allow delete: if false;
    }

    match /Debts/{debtId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated()
        && isValidDebt(request.resource.data)
        && request.resource.data.get('ledger_revision', 0) == 0
        && request.resource.data.get('ledger_payment_id', '') == ''
        && (request.resource.data.get('total_parcelas', 1) <= 1
          || hasActivePremium())
        && (request.resource.data.get('itens', []).size() == 0
          || hasActivePremium());
      allow update: if isAuthenticated()
        && resource.data.user_id == request.auth.uid
        && isValidDebt(request.resource.data)
        && request.resource.data.user_id == resource.data.user_id
        && safeDebtUpdate(debtId);
      allow delete: if isAuthenticated()
        && resource.data.user_id == request.auth.uid
        && resource.data.get('ledger_revision', 0) == 0;
    }

    match /Payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated()
        && isValidPayment(request.resource.data)
        && paymentHasOwnedDebt(request.resource.data)
        && request.resource.data.get('estornado_em', null) == null
        && request.resource.data.get('estorno_motivo', null) == null
        && (get(/databases/$(database)/documents/Debts/$(request.resource.data.debt_id)).data.get('ledger_revision', 0) == 0
          || coordinatedPayment(request.resource.data, paymentId));
      allow update: if isAuthenticated()
        && resource.data.user_id == request.auth.uid
        && isValidPayment(request.resource.data)
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.debt_id == resource.data.debt_id
        && paymentHasOwnedDebt(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estornado_em', 'estorno_motivo'])
        && resource.data.get('estornado_em', null) == null
        && request.resource.data.get('estornado_em', null) == request.time
        && requiredString(request.resource.data, 'estorno_motivo', 200)
        && coordinatedPayment(request.resource.data, paymentId);
      allow delete: if false;
    }

    match /Bills/{billId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated()
        && hasActivePremium()
        && isValidBill(request.resource.data);
      allow update: if isAuthenticated()
        && resource.data.user_id == request.auth.uid
        && hasActivePremium()
        && isValidBill(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    match /PremiumCharges/{chargeId} {
      allow read, write: if false;
    }

    function validFollowUp() {
      return request.resource.data.user_id == request.auth.uid
        && hasOnlyAllowedFields([
          'user_id', 'contact_key', 'client_name', 'note', 'last_contacted_at',
          'next_contact_at', 'promised_amount', 'updated_at'
        ])
        && requiredString(request.resource.data, 'contact_key', 200)
        && requiredString(request.resource.data, 'client_name', 80)
        && optionalString(request.resource.data, 'note', 1000)
        && optionalTimestamp(request.resource.data, 'last_contacted_at')
        && optionalTimestamp(request.resource.data, 'next_contact_at')
        && (request.resource.data.get('promised_amount', null) == null
          || (request.resource.data.promised_amount is number
            && request.resource.data.promised_amount > 0
            && request.resource.data.promised_amount <= 100000000))
        && request.resource.data.updated_at == request.time;
    }

    match /CollectionFollowUps/{followUpId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && validFollowUp();
      allow update: if isAuthenticated()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.contact_key == resource.data.contact_key
        && validFollowUp();
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    match /Presence/{userId} {
      allow read, delete: if false;
      allow create, update: if isOwner(userId)
        && hasOnlyAllowedFields(['last_seen_at', 'plataforma'])
        && request.resource.data.last_seen_at == request.time
        && optionalString(request.resource.data, 'plataforma', 20);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
