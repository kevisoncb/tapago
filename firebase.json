{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tapago-ae948",
          "appId": "1:1077428127080:android:04ca9e29d571127c0042dd",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tapago-ae948",
          "configurations": {
            "android": "1:1077428127080:android:04ca9e29d571127c0042dd",
            "ios": "1:1077428127080:ios:cfb8bcee870273c20042dd",
            "macos": "1:1077428127080:ios:cfb8bcee870273c20042dd"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "site",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/premium/pix",
        "function": {
          "functionId": "createPremiumPix",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/premium/pix/**",
        "function": {
          "functionId": "premiumPixStatus",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/play/confirm",
        "function": {
          "functionId": "confirmPlayPurchase",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/webhooks/asaas",
        "function": {
          "functionId": "asaasWebhook",
          "region": "southamerica-east1"
        }
      }
    ]
  }
}
