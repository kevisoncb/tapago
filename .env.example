# =============================================================================
# TáPago — modelo do .env
# =============================================================================
# Copie para .env neste PC (o .env não entra no Git).
# Painel: https://www.asaas.com
# =============================================================================

# Integrações → Chaves API → Gerar chave de API (só aparece na hora).
ASAAS_API_KEY=

# Produção. Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL=https://api.asaas.com/v3

# Integrações → Webhooks → Criar Webhook
# URL: https://tapago-ae948.web.app/api/webhooks/asaas
# Cole o mesmo token no campo "token de autenticação" do Asaas.
ASAAS_WEBHOOK_TOKEN=

# Só o servidor Dart local (opcional). Produção usa Cloud Functions.
ASAAS_PORT=8787
