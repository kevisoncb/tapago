{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tapago-ae948",
          "appId": "1:1077428127080:android:53dca34d493288510042dd",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tapago-ae948",
          "configurations": {
            "android": "1:1077428127080:android:53dca34d493288510042dd",
            "ios": "1:1077428127080:ios:577755df013cd6380042dd",
            "macos": "1:1077428127080:ios:577755df013cd6380042dd"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "hosting-redirect",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      }
    ],
    "redirects": [
      { "source": "/termos{,.html}", "destination": "https://usepago.web.app/termos", "type": 301 },
      { "source": "/privacidade{,.html}", "destination": "https://usepago.web.app/privacidade", "type": 301 },
      { "source": "/lgpd{,.html}", "destination": "https://usepago.web.app/lgpd", "type": 301 },
      { "source": "/ajuda{,.html}", "destination": "https://usepago.web.app/ajuda", "type": 301 },
      { "regex": "^/(?:a|ap|api)?$", "destination": "https://usepago.web.app/", "type": 301 },
      { "regex": "^/(?:[^a]|a[^p]|ap[^i]|api[^/]).*$", "destination": "https://usepago.web.app/", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/api/premium/pix",
        "function": {
          "functionId": "createPremiumPix",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/premium/pix/**",
        "function": {
          "functionId": "premiumPixStatus",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/play/confirm",
        "function": {
          "functionId": "confirmPlayPurchase",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/account/delete",
        "function": {
          "functionId": "deleteMyAccount",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/webhooks/asaas",
        "function": {
          "functionId": "asaasWebhook",
          "region": "southamerica-east1"
        }
      }
    ]
  }
}
